# Copy to .env to override defaults. All vars are optional.

LFM_QUANT=q4                 # "", fp16, q4, q4f16, q8, quantized
LFM_HOST=0.0.0.0
LFM_PORT=8383
# LFM_API_KEY=change-me        # if set, /chat endpoints require X-API-Key header
LFM_MAX_TOKENS=256
LFM_TEMPERATURE=0.1
LFM_TOP_K=50
LFM_REPETITION_PENALTY=1.05
# LFM_INTRA_OP_THREADS=0     # 0 = ORT default (all logical CPUs); physical-core count is faster (README)
# LFM_PROVIDERS=["CUDAExecutionProvider","CPUExecutionProvider"]   # GPU (see Dockerfile.gpu)
# LFM_LOCAL_MODEL_DIR=/models/onnx-export   # load from disk instead of the Hub

# Where the model is materialized (mount as a volume in Docker)
LFM_CACHE_DIR=models
